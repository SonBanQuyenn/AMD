{
  "Routes": [
    {
      "UpstreamPathTemplate": "/api/polls",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/polls",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "poll-service", "Port": 8080 }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/polls/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/polls/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "poll-service", "Port": 8080 }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/votes",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/votes",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "vote-service", "Port": 8080 }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/votes/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/votes/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "vote-service", "Port": 8080 }
      ]
    },
    {
      "UpstreamPathTemplate": "/hubs/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
      "DownstreamPathTemplate": "/hubs/{everything}",
      "DownstreamScheme": "ws",
      "DownstreamHostAndPorts": [
        { "Host": "realtime-service", "Port": 8080 }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://api-gateway:8080"
  }
}
